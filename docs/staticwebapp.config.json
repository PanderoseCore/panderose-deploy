{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "never",
  "routes": [
    { "route": "/", "redirect": "/docs/", "statusCode": 302 },
    {
      "route": "/docs/internal/*",
      "allowedRoles": ["authenticated"]
    },
    { "route": "/docs/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/docs/img/*", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/docs/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
  }
}
